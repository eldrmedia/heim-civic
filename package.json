{
  "name": "heim-civic-nevada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A nonpartisan, source-driven civic transparency product for Nevada.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:boundaries": "tsx scripts/build-boundaries.ts",
    "data:officials": "tsx scripts/build-officials.ts",
    "data:legislation": "tsx scripts/build-legislation.ts",
    "data:bill-index": "node --import tsx scripts/build-nevada-bill-index.ts",
    "data:bill-selection": "tsx scripts/audit-pilot-bill-selection.ts",
    "data:enhanced-bill-review": "tsx scripts/build-enhanced-bill-review.ts",
    "data:editorial-review-packets": "node --import tsx scripts/build-editorial-review-packets.ts",
    "data:promote-enhanced-bills": "node --import tsx scripts/promote-enhanced-bills.ts",
    "data:finance": "tsx scripts/build-finance.ts",
    "ops:source-health": "node --import tsx scripts/check-source-health.ts",
    "audit": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run ops:source-health && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/shpjs": "^3.4.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "fast-xml-parser": "^5.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shpjs": "^6.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
