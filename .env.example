# Public, non-secret application configuration only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only values belong below this line when integrations are introduced.
# Never prefix secrets with NEXT_PUBLIC_.
CENSUS_GEOCODER_BASE_URL=https://geocoding.geo.census.gov/geocoder/geographies/onelineaddress

# Set a stable random secret in hosted environments. Never expose this value.
LOOKUP_RATE_LIMIT_SECRET=

# Required to accept correction submissions in a hosted environment. The HTTPS
# receiver must store the case, preserve status/audit history, and restrict
# access to authorized editors. The bearer token is server-only.
CORRECTIONS_INTAKE_WEBHOOK_URL=
CORRECTIONS_INTAKE_WEBHOOK_TOKEN=
