# Public, non-secret application configuration only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only values belong below this line when integrations are introduced.
# Never prefix secrets with NEXT_PUBLIC_.
CENSUS_GEOCODER_BASE_URL=https://geocoding.geo.census.gov/geocoder/geographies/onelineaddress

# Set a stable random secret in hosted environments. Never expose this value.
LOOKUP_RATE_LIMIT_SECRET=

# Public mailbox for responsible vulnerability disclosure. Configure and
# monitor this address before launch; it is rendered through security.txt.
SECURITY_CONTACT_EMAIL=

# Required to accept correction submissions in a hosted environment. The HTTPS
# receiver must store the case, preserve status/audit history, and restrict
# access to authorized editors. The bearer token is server-only.
CORRECTIONS_INTAKE_WEBHOOK_URL=
CORRECTIONS_INTAKE_WEBHOOK_TOKEN=

# Required to accept pending waitlist requests. The HTTPS receiver must send a
# confirmation email and must not activate a contact before confirmation.
WAITLIST_INTAKE_WEBHOOK_URL=
WAITLIST_INTAKE_WEBHOOK_TOKEN=

# Absolute path to a private, access-controlled Phase 9.6 evidence record. Do
# not commit the completed record, screenshots, operator names, or vendor data.
LAUNCH_EVIDENCE_FILE=

# Final public HTTPS origin used by the operator-only production smoke check.
# This is not read by the application or exposed to the browser.
DEPLOYMENT_CHECK_URL=
