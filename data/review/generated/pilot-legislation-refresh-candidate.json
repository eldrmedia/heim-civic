720e988e86616fafc9dc05ad52d15b568a6cddd22103b59506e9b96e8b298600","coverageLabel":"Phase 4 bills and votes vertical slice","parserVersion":"pilot-legislation-v1","validationState":"source-verified"},{"id":"nv-ab83-assembly-members","organization":"Nevada Legislature (NELIS)","url":"https://www.leg.state.nv.us/App/NELIS/REL/83rd2025/Bill/GetBillVoteMembers?voteKey=12381&voteResultPanel=All","retrievedAt":"2026-09-20T16:57:52.492Z","documentSha256":"2379782ce217e6f438f89bddaebb43e8588552bb574ab465f97104f2da4c1093","coverageLabel":"Phase 4 bills and votes vertical slice","parserVersion":"pilot-legislation-v1","validationState":"source-verified"},{"id":"nv-ab83-senate-members","organization":"Nevada Legislature (NELIS)","url":"https://www.leg.state.nv.us/App/NELIS/REL/83rd2025/Bill/GetBillVoteMembers?voteKey=12798&voteResultPanel=All","retrievedAt":"2026-09-20T16:57:52.460Z","documentSha256":"4d5ccf5dfddac3f772ee97a2f052a7c11f4768d5957cdc0c76190b90913c9cc7","coverageLabel":"Phase 4 bills and votes vertical slice","parserVersion":"pilot-legislation-v1","validationState":"source-verified"}]},{"id":"us-119-hr1366","slug":"us-119-hr1366","jurisdiction":"federal","identifier":"H.R. 1366","session":"119th Congress","title":"Mining Regulatory Clarity Act","officialTitle":"To provide for the location of multiple hardrock mining mill sites, to establish the Abandoned Hardrock Mine Fund, and for other purposes.","policyArea":"Environmental Protection","status":{"label":"Passed House; on Senate calendar","asOf":"2026-03-17","latestAction":"Read twice. Placed on Senate Legislative Calendar under General Orders. Calendar No. 357."},"officialSummary":{"text":"Mining Regulatory Clarity ActThis bill allows mining operators to use federal lands for activities ancillary to mining, such as waste disposal, regardless of whether those lands contain mineral deposits valuable enough to be mined (mineral validity). It also establishes the Abandoned Hardrock Mine Fund.The bill addresses a 2022 decision in the U.S. Court of Appeals for the Ninth Circuit related to the Rosemont Copper Mine in Arizona (commonly known as the Rosemont decision, described further in CRS Report R48166). The court held that mining claims are only allowed where mineral validity has been established and that mill site claims are more appropriate means for establishing a mining waste disposal site under the Mining Act.The bill allows a mining operator to (1) locate and include within its plan of operations as many mill site claims (e.g., areas for waste rock disposal) as are reasonably necessary for its operations, and (2) use or occupy public land in accordance with an approved plan of operations.Additionally, the bill requires any revenue generated from fees for such mill site claims to be deposited into the Abandoned Hardrock Mine Fund. The Department of the Interior must use the fund for certain abandoned hardrock mine reclamation activities.","attribution":"Congressional Research Service summary published by Congress.gov","sourceUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1366","reviewState":"official-source"},"committees":["Natural Resources Committee"],"people":[{"officialId":"us-congress:bioguide:A000369","externalId":"us-congress:bioguide:A000369","name":"Mark E. Amodei","role":"sponsor"},{"officialId":"us-congress:bioguide:H001066","externalId":"us-congress:bioguide:H001066","name":"Steven Horsford","role":"cosponsor"},{"officialId":null,"externalId":"us-congress:bioguide:B001323","name":"Nicholas J. Begich","role":"cosponsor"}],"actions":[{"occurredOn":"2025-02-14","text":"Introduced in House"},{"occurredOn":"2025-02-14","text":"Referred to the House Committee on Natural Resources."},{"occurredOn":"2025-08-29","text":"Referred to the Subcommittee on Energy and Mineral Resources."},{"occurredOn":"2025-09-03","text":"Subcommittee Hearings Held"},{"occurredOn":"2025-09-17","text":"Subcommittee on Energy and Mineral Resources Discharged"},{"occurredOn":"2025-09-17","text":"Committee Consideration and Mark-up Session Held"},{"occurredOn":"2025-09-17","text":"Ordered to be Reported (Amended) by the Yeas and Nays: 25 - 17."},{"occurredOn":"2025-11-25","text":"Reported (Amended) by the Committee on Natural Resources. H. Rept. 119-386."},{"occurredOn":"2025-11-25","text":"Placed on the Union Calendar, Calendar No. 336."},{"occurredOn":"2025-12-16","text":"Rules Committee Resolution H. Res. 951 Reported to House. Rule provides for consideration of H.R. 4776, H.R. 1366, H.R. 845, H.R. 3616, H.R. 3632 and H.R. 4371. The resolution provides for consideration of H.R. 4776, under a structured rule and H.R. 1366, H.R. 845, H.R. 3616, H.R. 3632, and H.R. 4371 under a closed rule. The resolution provides one motion to recommit on each bill."},{"occurredOn":"2025-12-18","text":"Considered under the provisions of rule H. Res. 951. (consideration: CR H6044-6049)"},{"occurredOn":"2025-12-18","text":"Rule provides for consideration of H.R. 4776, H.R. 1366, H.R. 845, H.R. 3616, H.R. 3632 and H.R. 4371. The resolution provides for consideration of H.R. 4776, under a structured rule and H.R. 1366, H.R. 845, H.R. 3616, H.R. 3632, and H.R. 4371 under a closed rule. The resolution provides one motion to recommit on each bill."},{"occurredOn":"2025-12-18","text":"DEBATE - The House proceeded with one hour of debate on H.R. 1366."},{"occurredOn":"2025-12-18","text":"The previous question was ordered pursuant to the rule."},{"occurredOn":"2025-12-18","text":"Ms. Leger Fernandez moved to recommit to the Committee on Natural Resources. (text: CR H6049)"},{"occurredOn":"2025-12-18","text":"The previous question on the motion to recommit was ordered pursuant to clause 2(b) of rule XIX."},{"occurredOn":"2025-12-18","text":"POSTPONED PROCEEDINGS - At the conclusion of debate on H.R. 1366, the Chair put the question on motion to recommit and by voice vote announced the noes had prevailed. Ms. Leger Fernandez demanded the yeas and nays and the Chair postponed further proceedings until a time to be announced."},{"occurredOn":"2025-12-18","text":"Considered as unfinished business. (consideration: CR H6069-6070)"},{"occurredOn":"2025-12-18","text":"On motion to recommit Failed by the Yeas and Nays: 205 - 213 (Roll no. 357)."},{"occurredOn":"2025-12-18","text":"Passed/agreed to in House: On passage Passed by the Yeas and Nays: 219 - 198 (Roll no. 358)."},{"occurredOn":"2025-12-18","text":"On passage Passed by the Yeas and Nays: 219 - 198 (Roll no. 358). (text of amendment in the nature of a substitute: CR H6044)"},{"occurredOn":"2025-12-18","text":"Motion to reconsider laid on the table Agreed to without objection."},{"occurredOn":"2025-12-18","text":"Received in the Senate."},{"occurredOn":"2026-03-17","text":"Read twice. Placed on Senate Legislative Calendar under General Orders. Calendar No. 357."}],"votes":[{"id":"us-house-roll:357","chamber":"U.S. House","question":"On Motion to Recommit","result":"Failed","occurredOn":"2025-12-18","sourceUrl":"https://clerk.house.gov/Votes/2025357","memberCoverage":"nevada-delegation-only","totals":{"yes":205,"no":213,"present":0,"notVoting":15,"excused":0,"absent":0,"total":433},"memberVotes":[{"officialId":"us-congress:bioguide:A000369","externalId":"us-congress:bioguide:A000369","name":"Amodei (NV)","originalValue":"Nay","normalizedValue":"no"},{"officialId":"us-congress:bioguide:H001066","externalId":"us-congress:bioguide:H001066","name":"Horsford","originalValue":"Yea","normalizedValue":"yes"},{"officialId":"us-congress:bioguide:L000590","externalId":"us-congress:bioguide:L000590","name":"Lee (NV)","originalValue":"Yea","normalizedValue":"yes"},{"officialId":"us-congress:bioguide:T000468","externalId":"us-congress:bioguide:T000468","name":"Titus","originalValue":"Yea","normalizedValue":"yes"}]},{"id":"us-house-roll:358","chamber":"U.S. House","question":"On Passage","result":"Passed","occurredOn":"2025-12-18","sourceUrl":"https://clerk.house.gov/Votes/2025358","memberCoverag