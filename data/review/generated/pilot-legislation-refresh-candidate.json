{"schemaVersion":1,"snapshotId":"phase-4-legislation:2026-09-20","generatedAt":"2026-09-20T16:57:53.672Z","parserVersion":"pilot-legislation-v1","coverageLabel":"Phase 4 bills and votes vertical slice","bills":[{"id":"nv-83-2025-ab83","slug":"nv-83-2025-ab83","jurisdiction":"state","identifier":"AB83","session":"Nevada 83rd Session (2025)","title":"Designates “Larry Itliong Day” as a day of observance in this State.","officialTitle":"AN ACT relating to days of observance; requiring the Governor to annually proclaim October 25 to be “Larry Itliong Day” in the State of Nevada; and providing other matters properly relating thereto.","policyArea":"State government and observances","status":{"label":"Vetoed","asOf":"2025-06-03","latestAction":"(No further action taken.)"},"officialSummary":{"text":"Under existing law, various days, weeks and months of observance are recognized in this State. (NRS 236.018-236.095) This bill requires the Governor to annually proclaim October 25 to be “Larry Itliong Day” in the State of Nevada.","attribution":"Official Nevada Legislative Counsel Bureau digest","sourceUrl":"https://www.leg.state.nv.us/App/NELIS/REL/83rd2025/Bill/AB83/Overview","reviewState":"official-source"},"committees":["Assembly Government Affairs","Senate Government Affairs"],"people":[{"officialId":"nv-lcb:legislator:395","externalId":"https://www.leg.state.nv.us/App/Legislator/A/Assembly/83rd2025/14","name":"Erica Mosca","role":"sponsor"},{"officialId":"nv-lcb:legislator:401","externalId":"https://www.leg.state.nv.us/App/Legislator/A/Assembly/83rd2025/28","name":"Reuben D'Silva","role":"cosponsor"},{"officialId":null,"externalId":"https://www.leg.state.nv.us/App/Legislator/A/Assembly/83rd2025/7","name":"Tanya Flanagan","role":"cosponsor"},{"officialId":"nv-lcb:legislator:378","externalId":"https://www.leg.state.nv.us/App/Legislator/A/Assembly/83rd2025/16","name":"Cecelia González","role":"cosponsor"},{"officialId":null,"externalId":"https://www.leg.state.nv.us/App/Leg